<Page x:Class="Submission_of_Applications_Данилова.Pages.Status"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Submission_of_Applications_Данилова.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Status">

    <Grid Background="#F8F9FA">
        <Grid Margin="0,0,0,349.6" Background="White" >
            <Image HorizontalAlignment="Left" Height="40" Margin ="10,10,0,0" VerticalAlignment="Top" Width="40" Source="/Submission of Applications_Данилова;component/img/logo.png"/>
            <Label Content="Электронная приемная компания" FontSize="19" HorizontalAlignment="Left" Margin="55,1,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            <Label Content="Пермского авиационного техникума им. А. Д. Швецова" HorizontalAlignment="Left" Margin="55,24,0,0" VerticalAlignment="Top"/>
        </Grid>

        <Grid Margin="0,60,0,-0.4">
            <Label Content="Статус" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            <Label Content="Имею статус" HorizontalAlignment="Left" Margin="10,41,0,0" VerticalAlignment="Top"/>
            <Label Content="Отметить при наличии" HorizontalAlignment="Left" Margin="20,67,0,0" VerticalAlignment="Top" Background="{x:Null}" FontSize="10" Foreground="Red"/>
            <CheckBox Content="ребенок-сирота/ребенок, оставшийся без попечения родителей" HorizontalAlignment="Left" Margin="22,91,0,0" VerticalAlignment="Top"/>
            <CheckBox Content="инвалид" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,106,0,0"/>
            <CheckBox Content="малообеспеченный" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,122,0,0"/>
            <Label Content="Выберите один из вариантов:" HorizontalAlignment="Left" Margin="20,166,0,0" VerticalAlignment="Top" Background="{x:Null}" FontSize="10" Foreground="Red"/>
            <RadioButton Content="имею(при нажатии данной кнопки необходимо ниже прикрепить сканы страниц документа)" HorizontalAlignment="Left" Margin="20,190,0,0" VerticalAlignment="Top"/>
            <RadioButton Content="не имею" HorizontalAlignment="Left" Margin="20,210,0,0" VerticalAlignment="Top"/>
            <Label Content="Приписанное удостоверение(военный билет) " HorizontalAlignment="Left" Margin="10,140,0,0" VerticalAlignment="Top"/>
            <Label Content="Прикрепите сканы 1-ой и 2-щй страниц приписаного удостоверения или военного билета(стр. 1-5, 8-13, 20-21) при их наличии" HorizontalAlignment="Left" Margin="10,245,0,0" VerticalAlignment="Top"/>
            <TextBox Height="24" Margin="10,309,111,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" />
            <Button Content="Продолжить" HorizontalAlignment="Right" Margin="0,0,10,5" VerticalAlignment="Bottom" Width="150" Height="25"/>
            <Button Content="Выбрать" HorizontalAlignment="Right" Margin="0,0,10,56" VerticalAlignment="Bottom" Width="96" Height="26" RenderTransformOrigin="0.52,-1.256"/>
            <Label Content="(Формат документа должен быть PNG, JPEG или PDF, а максимальный размер каждого файла 5 МБ)" HorizontalAlignment="Left" Margin="20,281,0,0" VerticalAlignment="Top" Background="{x:Null}" FontSize="10" Foreground="Red" Width="477"/>

        </Grid>
    </Grid>
</Page>
