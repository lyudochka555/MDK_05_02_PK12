            <Button Content="Продолжить" HorizontalAlignment="Right" Margin="0,0,10,5" VerticalAlignment="Bottom" Width="135" Height="25"/>
            <Button Content="Выбрать" HorizontalAlignment="Right" Margin="0,0,10,34" VerticalAlignment="Bottom" Width="65" Height="25"/>
            <TextBox Height="24" Margin="415,237,22,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
            <Label Content="Средний балл (до сотых):" HorizontalAlignment="Left" Margin="415,211,0,0" VerticalAlignment="Top"/>
            <Label Content="Формат документа должен быть PNG, JPEG или PDF, а максимальный размер каждого файла 5 МБ" HorizontalAlignment="Left" Margin="12,303,0,0" VerticalAlignment="Top" Background="{x:Null}" FontSize="10" Foreground="Red" Width="477"/>
        </Grid>
    </Grid>
</Page>
